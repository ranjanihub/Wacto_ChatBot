{
  "name": "WACTO Chatbot Backend",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1",
      "name": "Chat Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "webhookId": "wacto-chat-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body;\n\n// Format history for Gemini\nconst formattedHistory = (body.history || []).map(msg => ({\n  role: msg.role === 'bot' ? 'model' : 'user',\n  parts: [{ text: msg.content }]\n}));\n\n// Add the current message\nformattedHistory.push({\n  role: 'user',\n  parts: [{ text: body.message }]\n});\n\nreturn {\n  contents: formattedHistory,\n  systemInstruction: {\n    role: \"system\",\n    parts: [{ text: \"You are the WACTO AI Assistant. Answer concisely. You help users understand WACTO (wacto.in), the Best WhatsApp Business API Provider in India.\\n\\nABOUT WACTO:\\n- What it is: A Next-Gen WhatsApp Automation platform for intelligent chatbots, CRM integrations, and automated lead generation.\\n- Features: WhatsApp API Setup, Bluetick Branding, Click-to-Chat Ads, QR codes, Website Chat Widgets, AI Chatbots, Lead Capture Forms.\\n- Engagement Tools: WhatsApp Broadcast (Drip Campaigns), Shared Team Inbox, AI Message Generators, WhatsApp Catalogs, Payments on WhatsApp, Reports & Analytics.\\n- Industries Served: Education, Real Estate, Automotive, Travel & Hospitality, Healthcare.\\n\\nAlways be helpful, professional, and use bullet points or emojis where appropriate.\" }]\n  }\n};"
      },
      "id": "2",
      "name": "Format for Gemini",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=YOUR_GEMINI_API_KEY_HERE",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {}
      },
      "id": "3",
      "name": "Call Gemini API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "4",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"reply\": \"{{ $json.candidates[0].content.parts[0].text }}\"\n}",
        "options": {}
      }
    },
    {
      "parameters": {
        "collection": "chat_logs",
        "options": {}
      },
      "id": "5",
      "name": "Save to MongoDB",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1.1,
      "position": [
        900,
        480
      ],
      "parameters": {
        "operation": "insert",
        "collection": "chat_logs",
        "fields": "={\n  \"user_message\": \"{{ $('Chat Webhook').item.json.body.message }}\",\n  \"ai_reply\": \"{{ $('Call Gemini API').item.json.candidates[0].content.parts[0].text }}\",\n  \"language\": \"{{ $('Chat Webhook').item.json.body.language }}\",\n  \"timestamp\": \"{{ $('Chat Webhook').item.json.body.timestamp }}\"\n}",
        "options": {}
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Chat Webhook": {
      "main": [
        [
          {
            "node": "Format for Gemini",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format for Gemini": {
      "main": [
        [
          {
            "node": "Call Gemini API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Gemini API": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          },
          {
            "node": "Save to MongoDB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
